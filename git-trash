#!/usr/bin/env bash

current_branch="$(git rev-parse --abbrev-ref HEAD)"
SKIP_BRANCHES="master|main|${current_branch}|${SKIP_BRANCHES:-"develop|development"}"

# The first entry is always the main worktree which can never be removed.
main_worktree="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"

icon_remote_gone="󰍑"
icon_remote_diff=""
icon_unknown=""
icon_info=""
icon_worktree="󰙅"

longest_branch_name=0

branches=()
trash=()
has_worktrees=false

while IFS=: read -r branch status worktree
do
    if [ -n "$worktree" ] && [ "$worktree" == "$main_worktree" ]; then
      continue
    fi

    if [ -n "$worktree" ]; then
      has_worktrees=true
    fi

    if [ ${#branch} -gt "$longest_branch_name" ]; then
      longest_branch_name=${#branch}
    fi

    branches+=("$branch:$status:$worktree")
done < <(git --no-pager branch --no-color --format='%(refname:short):%(upstream:track):%(worktreepath)' | grep -v -E "^($SKIP_BRANCHES):")

handle_choice () {
    IFS=: read -r branch_name tracking_status worktree_path <<< "$branch"

    if grep -q "gone" <<< "$tracking_status"; then
      status="$icon_remote_gone"
    elif grep -q -E "ahead|behind" <<< "$tracking_status"; then
      status="$icon_remote_diff"
    else
      status="$icon_unknown"
    fi

    printf "%-s " "$status"
    if $has_worktrees; then
      if [ -n "$worktree_path" ]; then
        printf "%-s " "$icon_worktree"
      else
        printf "  "
      fi
    fi

    printf "%-$longest_branch_name.${longest_branch_name}s [y/n/?]: " "$branch_name"
    read -r -n 1 ans
    if [[ "$ans" == "y" ]]; then
        trash+=("$branch_name:$worktree_path")
    fi
    if [[ "$ans" == "?" ]]; then
        printf "\n  %s " "$icon_info"
        git branch -vv --list "$branch_name"
        handle_choice
    fi
}

for branch in "${branches[@]}"; do
    handle_choice
    echo
done

if [ "${#trash[@]}" -lt "1" ]; then
    echo -e "\nnothing to delete"
    exit
fi

echo -e "\nyou will delete the following local branches:"
for trashbranch in "${trash[@]}"; do
  IFS=: read -r branch_name worktree_path <<< "$trashbranch"
  if [ -n "$worktree_path" ]; then
    echo "$branch_name (and worktree $worktree_path)"
  else
    echo "$branch_name"
  fi
done

echo; echo -n "type 'trash' to do it: "
read -r ans

if [[ "$ans" == "trash" ]]; then
  failures=0

  for trashbranch in "${trash[@]}"; do
    IFS=: read -r branch_name worktree_path <<< "$trashbranch"

    # Never force the removal. Git refuses for dirty, locked or submodule
    # worktrees and we keep the branch too so nothing is lost.
    if [ -n "$worktree_path" ] && ! git worktree remove "$worktree_path"; then
      echo "skipping $branch_name, could not remove worktree $worktree_path (see error above)"
      failures=$((failures + 1))
      continue
    fi

    if ! git branch -D "$branch_name"; then
      if [ -n "$worktree_path" ]; then
        echo "worktree $worktree_path removed but could not delete $branch_name"
      fi

      failures=$((failures + 1))
    fi
  done

  if [ "$failures" -gt 0 ]; then
    echo "done, but $failures branch(es) could not be trashed"
    exit 1
  fi

  echo 'done'
else
  echo 'coward'
fi
